# Copy this file to .env and fill it in. Never commit .env.
# All of the Supabase values are in your project's dashboard.

# Project Settings > API
MOCA_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The public "anon" (or "publishable") key. Safe in the browser.
MOCA_SUPABASE_ANON_KEY=
# The "service_role" (or "secret") key. Keep it private: it bypasses all access rules.
MOCA_SUPABASE_SERVICE_KEY=
# Only for older projects that sign tokens with a shared secret
# MOCA_SUPABASE_JWT_SECRET=

# Connect button > Session pooler. Put your database password in the address.
MOCA_DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The address of this app, for links in emails. Add it in Supabase too:
# Authentication > URL Configuration > Redirect URLs
MOCA_SITE_URL=http://127.0.0.1:8000

# Optional
# MOCA_GOOGLE_LOGIN=1            # after enabling Google under Authentication > Providers
# MOCA_STORAGE_BUCKET=moca-evidence
# MOCA_WHISPER_MODEL=small.en    # base.en is smaller and faster on a slow server
