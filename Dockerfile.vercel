# The image Vercel runs. Same app as Dockerfile, adjusted for short-lived serverless copies:
# the speech model is built in (no 500 MB download on every start), working files go to /tmp
# (the only writable folder), and it listens on Vercel's PORT (80 if unset).
FROM node:24-slim AS frontend
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 libportaudio2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements-web.txt

ENV HF_HOME=/app/hf-cache MOCA_WHISPER_MODEL=small.en
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('small.en', device='cpu', compute_type='int8')"

COPY *.py alembic.ini ./
COPY webapp/ webapp/
COPY migrations/ migrations/
COPY models/ models/
COPY images/ images/
COPY --from=frontend /app/frontend/dist frontend/dist
RUN chmod -R a+rX /app

ENV PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 MOCA_RESULTS_DIR=/tmp/moca-results MPLCONFIGDIR=/tmp/matplotlib
EXPOSE 80
CMD ["sh", "-c", "exec python -m uvicorn webapp.server:app --host 0.0.0.0 --port ${PORT:-80} --proxy-headers --forwarded-allow-ips '*'"]
